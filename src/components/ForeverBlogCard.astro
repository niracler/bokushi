---
import { getDailyIssue } from "../utils/foreverblog";

const issue = await getDailyIssue();
const [, month, day] = issue.date.split("-");
const dateLabel = `${Number(month)} 月 ${Number(day)} 日`;
---

<aside class="foreverblog-card surface-card" aria-label="十年之约 · 今天读什么">
    <div class="foreverblog-card__head">
        <a
            class="foreverblog-card__eyebrow eyebrow"
            href="https://www.foreverblog.cn/daily.html"
            target="_blank"
            rel="noopener noreferrer"
        >
            今天读什么
        </a>
        <span class="foreverblog-card__date">
            {issue.stale ? `快照 · ${dateLabel}` : dateLabel}
        </span>
    </div>
    <ul class="foreverblog-card__picks">
        {
            issue.picks.map((pick) => (
                <li class="foreverblog-card__pick">
                    <a
                        class="foreverblog-card__title"
                        href={pick.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {pick.title}
                    </a>
                    <p class="foreverblog-card__note">
                        <span class="foreverblog-card__pill pill" data-tone="accent">
                            编辑推荐
                        </span>
                        <span class="foreverblog-card__note-text">{pick.note}</span>
                    </p>
                </li>
            ))
        }
    </ul>
    <div class="foreverblog-card__foot">
        <a
            class="foreverblog-card__cta"
            href="https://www.foreverblog.cn/go.html"
            target="_blank"
            rel="noopener noreferrer"
        >
            虫洞 · 随便去一位博主那儿看看
            <span aria-hidden="true">→</span>
        </a>
        <a
            class="foreverblog-card__via"
            href={issue.issueUrl}
            target="_blank"
            rel="noopener noreferrer"
        >
            via 十年之约
        </a>
    </div>
</aside>

<style>
    .foreverblog-card {
        display: grid;
        gap: var(--space-4);
        margin-block: var(--space-6);
        padding: var(--space-5);
    }

    .foreverblog-card__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
    }

    .foreverblog-card__eyebrow.foreverblog-card__eyebrow {
        color: var(--color-accent);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .foreverblog-card__eyebrow.foreverblog-card__eyebrow:hover {
        color: var(--color-accent-dark);
    }

    .foreverblog-card__date {
        font-size: var(--font-size-2xs);
        color: var(--color-text-muted);
        letter-spacing: 0.08em;
    }

    .foreverblog-card__picks {
        display: grid;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .foreverblog-card__pick {
        display: grid;
        gap: var(--space-1);
        margin: 0;
    }

    .foreverblog-card__pick + .foreverblog-card__pick {
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border-soft);
    }

    .foreverblog-card__title {
        color: var(--color-text-primary);
        font-size: var(--font-size-base);
        font-weight: 600;
        line-height: var(--line-height-compact);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .foreverblog-card__title:hover {
        color: var(--color-link-hover);
    }

    .foreverblog-card__note {
        display: flex;
        align-items: baseline;
        gap: var(--space-2);
        margin: 0;
        color: var(--color-text-secondary);
        font-size: var(--font-size-sm);
        line-height: var(--line-height-relaxed);
    }

    .foreverblog-card__pill {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    .foreverblog-card__note-text {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .foreverblog-card__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-top: var(--space-3);
        border-top: 1px solid var(--color-border-soft);
    }

    .foreverblog-card__cta {
        color: var(--color-accent);
        font-size: var(--font-size-sm);
        font-weight: 600;
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .foreverblog-card__cta:hover {
        color: var(--color-accent-dark);
    }

    .foreverblog-card__via {
        color: var(--color-text-muted);
        font-size: var(--font-size-2xs);
        letter-spacing: 0.08em;
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .foreverblog-card__via:hover {
        color: var(--color-text-secondary);
    }
</style>
