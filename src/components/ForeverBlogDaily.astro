---
interface Props {
    class?: string;
}

const { class: className = "" } = (Astro.props as Props) ?? {};

const widgetUrl = (theme: "light" | "dark") =>
    `https://www.foreverblog.cn/widget/today.html?theme=${theme}`;
---

<div class={`foreverblog-daily ${className}`}>
    <iframe
        src={widgetUrl("light")}
        title="十年之约 · 今天读什么"
        loading="lazy"
        sandbox="allow-popups allow-popups-to-escape-sandbox"
        class="foreverblog-daily__frame foreverblog-daily__frame--on-light"
    ></iframe>
    <iframe
        src={widgetUrl("dark")}
        title="十年之约 · 今天读什么"
        loading="lazy"
        sandbox="allow-popups allow-popups-to-escape-sandbox"
        class="foreverblog-daily__frame foreverblog-daily__frame--on-dark"
    ></iframe>
</div>

<style>
    .foreverblog-daily {
        display: grid;
        justify-items: center;
    }

    .foreverblog-daily__frame {
        width: 100%;
        max-width: 360px;
        height: 260px;
        border: 0;
        grid-area: 1 / 1;
    }

    .foreverblog-daily__frame--on-dark {
        visibility: hidden;
    }

    :global([data-theme="dark"]) .foreverblog-daily__frame--on-light {
        visibility: hidden;
    }

    :global([data-theme="dark"]) .foreverblog-daily__frame--on-dark {
        visibility: visible;
    }
</style>
