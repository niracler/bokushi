---
import { renderIcon } from "@hyoban/trip-map";
import { basePath, type entries, tripId } from "../../data/japan-trip";

interface Props {
    entry: (typeof entries)[number];
}
const { entry } = Astro.props;
---
<article class="entry" data-trip-map-stop-entry={entry.anchor}>
    <div class="entry-header">
        <h3>{entry.name}</h3>
        <a class="from-here play-action" href={`${basePath}/play#${entry.anchor}`} data-trip-map-stop-play={tripId} data-trip-map-stop={entry.anchor} aria-label={`从${entry.name}回放`} title="从这里回放"><Fragment set:html={renderIcon("play")} /></a>
    </div>
    {entry.images.length > 0 && <div class:list={["photo-grid", {single: entry.images.length === 1}]}>
        {entry.images.map((photo, index) => (
            <a href={photo.src} data-photo-url={photo.src} data-caption={photo.alt} aria-label={photo.alt} hidden={index >= 4}>
                {index < 4 && <img src={photo.thumbnail} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />}
                {index === 3 && entry.images.length > 4 && <span class="more">+{entry.images.length - 4}</span>}
            </a>
        ))}
    </div>}
    <p>{entry.text}</p>
</article>
<style>
.entry { margin: .8rem 0 1.3rem; }
.entry-header { display:flex;align-items:center;justify-content:space-between; gap:.5rem; margin-bottom:.4rem; }
.entry h3 { font: 650 1rem/1.4 system-ui,sans-serif; margin:0; }
.entry p { margin:.5rem 0 0; font-size:.93rem; line-height:1.6; }
.from-here { display:grid;place-items:center;color:var(--color-tx-2);width:2rem;height:2rem;border-radius:50%;background:var(--color-inline); }
.from-here :global(svg) { width:1rem;height:1rem; }
.photo-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;overflow:hidden;border-radius:.65rem; }
.photo-grid.single { grid-template-columns:1fr; }
.photo-grid a { position:relative;display:block; }
.photo-grid a[hidden] { display:none; }
.photo-grid img { display:block;width:100%;height:100%;aspect-ratio:1.4;object-fit:cover; }
.photo-grid.single img { aspect-ratio:1.6; }
.more { position:absolute;inset:0;display:grid;place-items:center;background:#0006;color:white;font-size:1.5rem; }
</style>
