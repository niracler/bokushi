---
interface Props {
    dayLabel: string;
    weekday: string;
    postCount: number;
    /** When set, renders as a month anchor target for the spine's jump links. */
    monthAnchor?: string;
}

const { dayLabel, weekday, monthAnchor } = Astro.props;
---

<div
    class:list={["day", { "day--month-anchor": !!monthAnchor }]}
    {...(monthAnchor ? { id: monthAnchor } : {})}
>
    <span class="day__pill">
        <span class="day__date">{dayLabel}</span>
        <span class="day__wk">{weekday}</span>
    </span>
</div>

<style>
    .day {
        display: flex;
        justify-content: center;
        margin: 0.5rem 0 0.35rem;
    }

    .day--month-anchor {
        scroll-margin-top: 5rem;
    }

    .day__pill {
        display: inline-flex;
        align-items: baseline;
        gap: 0.4rem;
        padding: 0.24rem 0.85rem;
        border-radius: 999px;
        background: rgba(58, 40, 30, 0.72);
        border: 1px solid rgba(255, 250, 244, 0.18);
        box-shadow: 0 2px 6px rgba(42, 28, 23, 0.12);
        backdrop-filter: blur(8px);
        font-family: "Fira Code", "SFMono-Regular", Menlo, monospace;
        line-height: 1.3;
    }

    .day__date {
        font-size: 0.78rem;
        color: #fffaf4;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .day__wk {
        font-size: 0.68rem;
        color: #ffd2be;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
    }

    :global(:root[data-theme="dark"]) .day__pill {
        background: rgba(44, 31, 24, 0.88);
        border-color: var(--color-border);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

    :global(:root[data-theme="dark"]) .day__date {
        color: var(--color-text-primary);
    }

    :global(:root[data-theme="dark"]) .day__wk {
        color: var(--color-accent);
    }
</style>
