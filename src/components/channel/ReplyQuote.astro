---
import type { ReplyInfo } from "../../utils/telegram";

interface Props {
    reply: ReplyInfo;
}

const { reply } = Astro.props;
const WrapperTag = reply.replyToLink ? "a" : "div";
const wrapperProps = reply.replyToLink
    ? { href: reply.replyToLink, target: "_blank", rel: "noopener noreferrer" }
    : {};
---

<WrapperTag
    class:list={["tg-reply", { "tg-reply--clickable": !!reply.replyToLink }]}
    {...wrapperProps}
>
    {reply.replyToThumb && (
        <span class="tg-reply__thumb">
            <img src={reply.replyToThumb} alt="" loading="lazy" data-lightbox-skip />
        </span>
    )}
    <div class="tg-reply__body">
        {reply.replyToAuthor && (
            <div class="tg-reply__author">{reply.replyToAuthor}</div>
        )}
        {reply.replyToText && (
            <div class="tg-reply__text">{reply.replyToText}</div>
        )}
    </div>
</WrapperTag>

<style>
    /* Official Telegram .tgme_widget_message_reply structure + bokushi warm palette */
    .tg-reply {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.38rem 0.6rem 0.38rem 0.7rem;
        margin: 0.15rem 0 0.45rem;
        border-radius: 6px;
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        background: var(--color-bg-muted);
        text-decoration: none;
        color: inherit;
        min-width: 0;
        overflow: hidden;
    }

    .tg-reply--clickable {
        cursor: pointer;
        transition: background-color var(--transition-fast), border-color var(--transition-fast);
    }

    .tg-reply--clickable:hover {
        background: color-mix(in srgb, var(--color-accent-soft) 50%, var(--color-bg-muted));
        border-color: var(--color-accent);
    }

    .tg-reply__thumb {
        flex: 0 0 35px;
        width: 35px;
        height: 35px;
        border-radius: 4px;
        overflow: hidden;
        background: var(--color-bg-muted);
    }

    .tg-reply__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .tg-reply__body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .tg-reply__author {
        font-size: 0.8rem;
        line-height: 1.25;
        font-weight: 600;
        color: var(--color-accent-dark);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tg-reply__text {
        font-size: 0.82rem;
        line-height: 1.35;
        color: var(--color-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
