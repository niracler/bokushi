---
import type { LinkPreview } from "../../utils/telegram";

interface Props {
    preview: LinkPreview;
}

const { preview } = Astro.props;
---

<a
    href={preview.url}
    target="_blank"
    rel="noopener noreferrer"
    class="tg-link-preview"
>
    <div class="tg-link-preview__body">
        {preview.siteName && (
            <div class="tg-link-preview__site">{preview.siteName}</div>
        )}
        {preview.title && (
            <div class="tg-link-preview__title">{preview.title}</div>
        )}
        {preview.description && (
            <div class="tg-link-preview__desc">{preview.description}</div>
        )}
    </div>
    {preview.imageUrl && (
        <div class="tg-link-preview__thumb">
            <img
                src={preview.imageUrl}
                alt={preview.title || ""}
                loading="lazy"
                data-lightbox-skip
            />
        </div>
    )}
</a>

<style>
    /* Official Telegram .tgme_widget_message_link_preview style + bokushi warm palette */
    .tg-link-preview {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        padding: 0.48rem 0.65rem 0.48rem 0.75rem;
        margin-top: 0.45rem;
        border-radius: 6px;
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        background: var(--color-bg-muted);
        text-decoration: none;
        color: inherit;
        transition: background-color var(--transition-fast), border-color var(--transition-fast);
        min-width: 0;
        overflow: hidden;
    }

    .tg-link-preview:hover {
        background: color-mix(in srgb, var(--color-accent-soft) 45%, var(--color-bg-muted));
        border-color: var(--color-accent);
    }

    .tg-link-preview__body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .tg-link-preview__site {
        font-size: 0.8rem;
        line-height: 1.25;
        color: var(--color-accent-dark);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tg-link-preview__title {
        font-size: 0.85rem;
        line-height: 1.3;
        font-weight: 600;
        color: var(--color-text-primary);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .tg-link-preview__desc {
        font-size: 0.81rem;
        line-height: 1.35;
        color: var(--color-text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .tg-link-preview__thumb {
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        border-radius: 4px;
        overflow: hidden;
        background: var(--color-bg-muted);
        margin-top: 0.1rem;
    }

    .tg-link-preview__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
