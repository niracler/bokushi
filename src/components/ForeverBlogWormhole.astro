---
interface Props {
    class?: string;
}

const { class: className = "" } = (Astro.props as Props) ?? {};

const wormholeHref = "https://www.foreverblog.cn/go.html";
const lightLogo = "https://www.foreverblog.cn/assets/logo/wormhole_v2_dark.webp";
const darkLogo = "https://www.foreverblog.cn/assets/logo/wormhole_v2_light.webp";
---

<a
    href={wormholeHref}
    target="_blank"
    rel="noopener noreferrer"
    title="虫洞 · 随机访问十年之约成员博客"
    class={`foreverblog-wormhole ${className}`}
>
    <img
        src={lightLogo}
        alt="十年之约虫洞"
        height="32"
        loading="lazy"
        decoding="async"
        class="foreverblog-wormhole__logo foreverblog-wormhole__logo--on-light"
    />
    <img
        src={darkLogo}
        alt=""
        aria-hidden="true"
        height="32"
        loading="lazy"
        decoding="async"
        class="foreverblog-wormhole__logo foreverblog-wormhole__logo--on-dark"
    />
</a>

<style>
    .foreverblog-wormhole {
        display: inline-flex;
        align-items: center;
        opacity: 0.85;
        transition: opacity 0.2s ease;
    }

    .foreverblog-wormhole:hover {
        opacity: 1;
    }

    .foreverblog-wormhole__logo {
        display: block;
        width: auto;
        height: 32px;
    }

    .foreverblog-wormhole__logo--on-dark {
        display: none;
    }

    :global([data-theme="dark"]) .foreverblog-wormhole__logo--on-light {
        display: none;
    }

    :global([data-theme="dark"]) .foreverblog-wormhole__logo--on-dark {
        display: block;
    }
</style>
