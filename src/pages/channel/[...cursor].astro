---
/**
 * Telegram Channel Display Page — v4 「剪报本」 layout
 *
 * Structure: narrow strip at top + 3-col layout (month spine | feed | rail)
 * Feed is grouped by day, with 2-col CSS-columns masonry per day group.
 * Cards come in 5 variants detected from the post shape (see telegram.ts).
 *
 * @author Niracler
 */

import { env } from "cloudflare:workers";
import BaseHead from "../../components/BaseHead.astro";
import ChannelDayDivider from "../../components/channel/ChannelDayDivider.astro";
import ChannelRail from "../../components/channel/ChannelRail.astro";
import PostCard from "../../components/channel/PostCard.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Lightbox from "../../components/Lightbox.astro";
import { archive, CHANNEL as CHANNEL_USERNAME, isChannelCursor } from "../../lib/channel/client";
import { CHANNEL_FALLBACK_TIME_ZONE, channelClockFormatter } from "../../utils/channel-time";
import type { TelegramChannel } from "../../utils/telegram";
import { collectForwardSources, groupPostsByDay, tallyByType } from "../../utils/telegram";

// Enable server-side rendering for this dynamic route
export const prerender = false;

const { cursor } = Astro.params;
const key = cursor ?? "home";
if (!isChannelCursor(key) || cursor === "home") return new Response(null, { status: 404 });

let channelData: (TelegramChannel & { firstId?: string; lastId?: string }) | undefined;
let error: string | null = null;
try {
    const snapshot = await archive(env).page(key);
    if (!snapshot) return new Response(null, { status: 404 });
    channelData = snapshot;
} catch (e) {
    error = "暂时无法加载频道";
    console.error("Error reading channel snapshot:", e);
}

const firstPostId = channelData?.firstId;
const lastPostId = channelData?.lastId;

const hasNewerPosts = Boolean(cursor);
const hasOlderPosts = Boolean(lastPostId);

// Never cache the rendered error fallback as a successful channel page.
if (error) Astro.response.status = 502;
Astro.response.headers.set("Cache-Control", error ? "no-store" : "public, max-age=0");

const timeFormatter = channelClockFormatter(CHANNEL_FALLBACK_TIME_ZONE);
const posts = channelData?.posts ?? [];
const dayGroups = groupPostsByDay(posts);
const typeCounts = tallyByType(posts);
const forwardSources = collectForwardSources(posts, 4);

// Track which days are the first of their month — only those get the month anchor id,
// so deep links like /channel#m-2026-04 still work for bookmarking a specific month.
const monthAnchorSeen = new Set<string>();
const dayGroupsWithAnchor = dayGroups.map((group) => {
    const needsAnchor = !monthAnchorSeen.has(group.monthAnchor);
    if (needsAnchor) monthAnchorSeen.add(group.monthAnchor);
    return { ...group, anchorId: needsAnchor ? group.monthAnchor : undefined };
});

// Eyebrow "YYYY·MM" — latest month present in this slice
const latestPost = posts[0];
const currentMonthLabel = dayGroups[0]?.monthLabel;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={channelData?.title ? `${channelData.title} - 动态` : '动态'}
      description={channelData?.description || '我的最新动态和分享'}
      image={channelData?.avatar}
    />
  </head>
  <body class="channel-page">
    <Header />
    <main id="main-content" class="page-shell max-w-5xl section-stack">
      {error ? (
        <div class="error-message surface-card">
          <h1>加载频道失败</h1>
          <p>{error}</p>
          <p>
            请访问 <a href={`https://t.me/${CHANNEL_USERNAME}`} target="_blank" rel="noopener noreferrer">
              Telegram 频道
            </a>
          </p>
        </div>
      ) : channelData ? (
        <>
          <div class="channel-layout">
            <details class="channel-intro">
              <summary><strong>{channelData.title}</strong><span>频道介绍</span></summary>
              <ChannelRail
                channelTitle={channelData.title}
                channelAvatar={channelData.avatar}
                username={CHANNEL_USERNAME}
                currentMonthLabel={currentMonthLabel}
                description={channelData.description}
                typeCounts={typeCounts}
                forwardSources={forwardSources}
              />
            </details>
            <section class="channel-main">
              <div class="day-list">
                {dayGroupsWithAnchor.map((group) => (
                  <section class="day-group">
                    <ChannelDayDivider
                      dayLabel={group.dayLabel}
                      weekday={group.weekday}
                      postCount={group.posts.length}
                      monthAnchor={group.anchorId}
                    />
                    <div class="feed">
                      {group.posts.map((post) => (
                        <PostCard
                          post={post}
                          channelUsername={CHANNEL_USERNAME}
                          timeFormatter={timeFormatter}
                          firstPost={post === latestPost}
                        />
                      ))}
                    </div>
                  </section>
                ))}
              </div>

              <nav class="pager">
                {hasNewerPosts && firstPostId && (
                  <a href={`/channel/after-${firstPostId}`} class="pager__link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    更新的
                  </a>
                )}
                <a
                  href="/channel"
                  class:list={["pager__link", { "pager__link--active": !cursor }]}
                >
                  最新
                </a>
                {hasOlderPosts && lastPostId && (
                  <a href={`/channel/before-${lastPostId}`} class="pager__link">
                    更早的
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                )}
              </nav>
            </section>
          </div>
        </>
      ) : null}
    </main>
    <Footer />
    <Lightbox id="channel-lightbox" selector=".card__content img:not([data-lightbox-skip]), .telegram-post-image" />
  </body>
</html>

<script>
  import { localizeChannelDates } from "../../scripts/channel-local-time";

  localizeChannelDates();

  const intro = document.querySelector<HTMLDetailsElement>('.channel-intro');
  if (intro) {
    const desktop = matchMedia('(width > 900px)');
    const syncIntro = () => { intro.open = desktop.matches; };
    syncIntro();
    desktop.addEventListener('change', syncIntro);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.card__content img').forEach((element) => {
      const img = element as HTMLImageElement;
      img.classList.add('telegram-post-image');
      img.loading = img.loading || 'lazy';
    });

    // Toggle official Telegram expandable blockquotes on click
    document.querySelectorAll<HTMLElement>('.card__content blockquote[expandable]').forEach((bq) => {
      if (bq.scrollHeight <= bq.clientHeight + 4) {
        bq.removeAttribute('expandable');
        return;
      }
      bq.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) return;
        if (bq.hasAttribute('open')) {
          bq.removeAttribute('open');
        } else {
          bq.setAttribute('open', '');
        }
      });
    });

    document.querySelectorAll<HTMLElement>('.card__content table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-scroll-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-scroll-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });

    // Client-side fallback: detect remaining raw pipe-table text and wrap in <pre>
    document.querySelectorAll<HTMLElement>('.card__content').forEach((content) => {
      const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
      const pipeLineRe = /^\s*\|.+\|\s*$/;
      const sepRe = /^\s*\|[\s\-:]+(\|[\s\-:]+)+\|\s*$/;
      const nodesToReplace: { node: Text; tableText: string; before: string; after: string }[] = [];

      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        const text = node.textContent || '';
        const lines = text.split('\n');
        let tableStart = -1;

        for (let idx = 0; idx < lines.length; idx++) {
          if (pipeLineRe.test(lines[idx])) {
            if (tableStart === -1) tableStart = idx;
            if (
              idx >= tableStart + 1 &&
              sepRe.test(lines[tableStart + 1]) &&
              idx >= tableStart + 2
            ) {
              // Continue collecting
            }
          } else {
            if (
              tableStart !== -1 &&
              idx - tableStart >= 3 &&
              sepRe.test(lines[tableStart + 1])
            ) {
              const before = lines.slice(0, tableStart).join('\n');
              const tableText = lines.slice(tableStart, idx).join('\n');
              const after = lines.slice(idx).join('\n');
              nodesToReplace.push({ node, tableText, before, after });
            }
            tableStart = -1;
          }
        }
        if (
          tableStart !== -1 &&
          lines.length - tableStart >= 3 &&
          sepRe.test(lines[tableStart + 1])
        ) {
          const before = lines.slice(0, tableStart).join('\n');
          const tableText = lines.slice(tableStart).join('\n');
          nodesToReplace.push({ node, tableText, before, after: '' });
        }
      }

      for (const { node: textNode, tableText, before, after } of nodesToReplace) {
        const frag = document.createDocumentFragment();
        if (before) frag.appendChild(document.createTextNode(before));
        const pre = document.createElement('pre');
        pre.className = 'pipe-table-fallback';
        pre.textContent = tableText;
        frag.appendChild(pre);
        if (after) frag.appendChild(document.createTextNode(after));
        textNode.parentNode?.replaceChild(frag, textNode);
      }
    });
  });
</script>

<style>
  :global(body.channel-page) {
    background-color: color-mix(in srgb, var(--color-bg-muted) 68%, var(--color-border) 32%);
  }

  :global(:root[data-theme="dark"] body.channel-page) {
    background-color: color-mix(in srgb, var(--color-bg-page) 82%, #000 18%);
  }

  /* =================================================================
   * Layout: Telegram bubble stream (main) + channel rail (right)
   * Below 900px the rail drops to avoid squeezing the feed.
   * ================================================================= */
  .channel-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    grid-template-areas: "feed intro";
    gap: var(--space-8);
    align-items: start;
    max-width: 55rem;
    margin-inline: auto;
  }

  .channel-intro {
    grid-area: intro;
    position: sticky;
    top: 5rem;
    min-width: 0;
  }

  .channel-intro > summary {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-primary);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .channel-intro > summary span {
    float: inline-end;
    margin-inline-start: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  @media (width > 900px) {
    .channel-intro[open] > summary { display: none; }
  }

  .channel-main {
    grid-area: feed;
    min-width: 0;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .channel-layout {
      grid-template-columns: 1fr;
      grid-template-areas: "intro" "feed";
      gap: var(--space-4);
    }

    .channel-intro {
      position: static;
      max-width: 34rem;
      width: 100%;
      margin-inline: auto;
    }

    .channel-intro :global(.rail) {
      position: static;
      max-height: none;
      margin-top: var(--space-3);
    }
  }

  /* =================================================================
   * Telegram Bubble Stream (Option A: centered date pills + bubbles)
   * ================================================================= */
  .day-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .day-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  /* =================================================================
   * Pager
   * ================================================================= */
  .pager {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-soft);
  }

  .pager__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .pager__link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .pager__link--active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  .pager__link--active:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: #fff;
  }

  /* =================================================================
   * Error state
   * ================================================================= */
  .error-message {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    color: var(--color-text-secondary);
  }

  .error-message h1 {
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .error-message a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pager {
      flex-wrap: wrap;
    }
  }
</style>
